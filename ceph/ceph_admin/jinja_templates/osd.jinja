{#- Recursively render a YAML value at the given indent (spaces). -#}
{%- macro render_value(value, indent) -%}
{%- if value is mapping -%}
{%- for key, val in value.items() %}
{{ indent }}{{ key }}:{% if val is mapping or (val is iterable and val is not string) %}{{ render_value(val, indent ~ '  ') }}{% else %} {{ val }}{% endif %}
{%- endfor -%}
{%- elif value is iterable and value is not string -%}
{%- for item in value %}
{{ indent }}-{% if item is mapping %}{% for key, val in item.items() %}{% if loop.first %} {{ key }}:{% if val is mapping or (val is iterable and val is not string) %}{{ render_value(val, indent ~ '    ') }}{% else %} {{ val }}{% endif %}{% else %}
{{ indent }}  {{ key }}:{% if val is mapping or (val is iterable and val is not string) %}{{ render_value(val, indent ~ '    ') }}{% else %} {{ val }}{% endif %}{% endif %}{% endfor %}{% else %} {{ item }}{% endif %}
{%- endfor -%}
{%- else -%}{{ value }}
{%- endif -%}
{%- endmacro -%}
{%- macro render_key_value(key, value, indent='') -%}
{{ indent }}{{ key }}:{% if value is mapping or (value is iterable and value is not string) %}{{ render_value(value, indent ~ '  ') }}{% else %} {{ value }}{% endif %}
{%- endmacro -%}
{%- set skip_keys = ['service_type', 'service_id', 'placement', 'spec'] -%}
---
service_type: {{ spec['service_type'] }}
{%- if spec.get('service_id') %}
service_id: {{ spec['service_id'] }}
{%- endif %}
{%- for key, value in spec.items() if key not in skip_keys %}
{{ render_key_value(key, value) }}
{%- endfor %}
placement:
{%- if spec['placement'].get('count') %}
  count: {{ spec['placement']['count'] }}
{%- endif -%}
{%- if spec['placement'].get('hosts') %}
  hosts: {{ spec['placement']['hosts'] }}
{%- endif -%}
{%- if spec['placement'].get('host_pattern') %}
  host_pattern: '{{ spec['placement']['host_pattern'] }}'
{%- endif -%}
{%- if spec['placement'].get('label') %}
  label: {{ spec['placement']['label'] }}
{%- endif %}
{%- if spec.get('spec') %}
spec:
{%- for key, value in spec['spec'].items() %}
{{ render_key_value(key, value, '  ') }}
{%- endfor %}
{%- endif %}
